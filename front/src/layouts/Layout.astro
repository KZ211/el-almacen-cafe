---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'El Almacén · Helados & Café',
	description = 'Helados y café en la esquina. Pedí por WhatsApp o vení a sentarte bajo la pérgola.',
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/jpeg" href="/logo-el-almacen.jpg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1d1a18" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen">
		<slot />
	</body>
</html>
