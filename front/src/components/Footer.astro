---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<!-- La vereda: cordón amarillo arriba y baldosas grises -->
<footer class="vereda vereda--lisa pt-[13px] text-tinta">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 pt-12 pb-32 md:flex-row md:items-end md:justify-between md:px-8 md:pt-14 md:pb-14">
		<div>
			<p class="font-cartel text-[2rem] leading-none">{site.name}</p>
			<p class="rotulo mt-2 text-[0.8rem] text-tinta/70">{site.tagline}</p>
		</div>
		<nav aria-label="Pie de página">
			<ul class="flex flex-wrap gap-x-6 gap-y-2">
				{
					site.nav.slice(1).map((link) => (
						<li>
							<a href={link.href} class="rotulo text-[0.8rem] underline-offset-4 hover:underline">{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="text-[0.85rem] text-tinta/70">© {year} {site.name}</p>
	</div>
</footer>
