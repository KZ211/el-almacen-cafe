---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<header
	class="pt-safe fixed top-0 z-50 w-full bg-surface/85 shadow-[0_1px_12px_rgba(43,27,23,0.06)] backdrop-blur-xl"
>
	<div class="flex h-16 items-center justify-between gap-space-sm px-margin md:mx-auto md:max-w-6xl md:px-8 md:h-18">
		<a href="#inicio" class="flex min-w-0 items-center gap-space-sm">
			<img src={site.logo} alt={`Logo ${site.name}`} width="32" height="32" class="h-8 w-8 shrink-0 rounded-md object-cover md:h-10 md:w-10" />
			<div class="flex min-w-0 flex-col">
				<span class="truncate font-headline text-headline-md leading-none tracking-tight text-primary">{site.name}</span>
				<span class="mt-0.5 truncate text-label-sm tracking-widest text-secondary uppercase">
					<span class="md:hidden">Inicio</span>
					<span class="hidden md:inline">{site.tagline}</span>
				</span>
			</div>
		</a>

		<!-- Navegación desktop: en mobile se usa el BottomNav -->
		<nav aria-label="Principal" class="hidden md:flex md:items-center md:gap-1 lg:gap-space-sm">
			{
				site.nav.map((link) => (
					<a
						href={link.href}
						class="rounded-full px-3 py-2 text-label-lg text-on-surface-variant transition-colors hover:bg-surface-container hover:text-primary"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex shrink-0 items-center gap-space-xs">
			<button
				type="button"
				aria-label="Buscar en la carta"
				class="flex h-11 w-11 items-center justify-center rounded-full text-on-surface transition-colors hover:bg-surface-container active:bg-surface-container-high"
			>
				<Icon name="search" class="text-[22px]" />
			</button>
			<div
				class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary shadow-[0_2px_8px_rgba(14,4,2,0.15)] md:hidden"
			>
				<Icon name="person" class="text-[18px] text-on-primary" />
			</div>
			<a
				href={site.whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden h-11 items-center gap-space-xs rounded-xl bg-primary px-space-md text-label-md tracking-wider text-on-primary uppercase shadow-[0_4px_12px_rgba(14,4,2,0.2)] transition-colors hover:bg-primary-container lg:flex"
			>
				<Icon name="chat" class="text-[18px]" />
				<span>Pedir</span>
			</a>
		</div>
	</div>
</header>
