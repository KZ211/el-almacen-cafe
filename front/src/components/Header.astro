---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
---

<!-- La pérgola: viga de hierro con los listones de pino colgando abajo -->
<header class="pt-safe fixed inset-x-0 top-0 z-50 bg-hierro">
	<div class="mx-auto flex h-13 max-w-6xl items-center justify-between gap-4 px-4 md:px-8">
		<a href="#inicio" class="font-cartel text-[1.35rem] leading-none text-cartel" aria-label="El Almacén, inicio">
			El Almacén
		</a>

		<nav aria-label="Secciones" class="hidden md:block">
			<ul class="flex items-center gap-1">
				{
					site.nav.slice(1).map((link) => (
						<li>
							<a
								href={link.href}
								class="rotulo block px-3 py-2 text-[0.8rem] text-cartel/80 underline-offset-[6px] transition-colors hover:text-cartel hover:underline hover:decoration-cordon hover:decoration-2"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a
			href={whatsappLink('¡Hola! Quiero hacer un pedido.')}
			target="_blank"
			rel="noopener noreferrer"
			class="rotulo hidden items-center gap-2 bg-cordon px-4 py-2 text-[0.8rem] text-tinta transition-colors hover:bg-pino-claro md:flex"
		>
			<Icon name="chat" class="size-4" />
			Pedí por WhatsApp
		</a>
	</div>
	<div class="listones h-7 shadow-[0_6px_10px_-4px_rgb(29_26_24/0.6)]" aria-hidden="true"></div>
</header>
