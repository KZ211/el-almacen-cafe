---
import Icon from './Icon.astro';
import { flavors, site, whatsappLink } from '../data/site';
---

<!-- Pizarra de gustos, pintada como el cartel: fondo blanco, letra de cartel -->
<section id="gustos" class="revoque relative isolate overflow-hidden px-4 pt-4 pb-24 md:px-8 md:pb-32" aria-labelledby="gustos-titulo">
	<div class="sombra-pergola pointer-events-none absolute -inset-x-[10%] inset-y-0 -z-10 opacity-70" aria-hidden="true"></div>
	<div class="pizarra relative mx-auto max-w-6xl bg-cartel px-6 py-12 text-tinta md:px-14 md:py-16">
		<div class="flex flex-col gap-4">
			<h2 id="gustos-titulo" class="text-[clamp(2.5rem,9vw,4.5rem)] leading-[0.95]">Algunos gustos de siempre</h2>
			<p class="max-w-[46ch] text-[1.05rem] leading-relaxed text-tinta-suave">
				Los del día cambian. Preguntanos por WhatsApp qué hay hoy y te armamos el pote.
			</p>
		</div>

		<ul class="gustos mt-12 columns-1 gap-12 border-t-2 border-tinta sm:columns-2 md:mt-16 lg:columns-3">
			{
				flavors.map((flavor) => (
					<li class="flex break-inside-avoid items-baseline gap-3 border-b border-tinta/15 py-3.5 font-cartel text-[1.45rem] leading-tight md:text-[1.6rem]">
						<span class="size-2 shrink-0 translate-y-[-0.2em] rounded-full bg-maceta" aria-hidden="true" />
						{flavor}
					</li>
				))
			}
		</ul>

		{!site.contentConfirmed && <p class="rotulo mt-4 text-[0.75rem] text-tinta-suave">Lista de ejemplo · a confirmar</p>}

		<div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
			<a
				href={whatsappLink('¡Hola! ¿Qué gustos tienen hoy?')}
				target="_blank"
				rel="noopener noreferrer"
				class="rotulo flex w-fit items-center gap-3 bg-tinta px-5 py-4 text-[0.95rem] text-cartel transition-colors hover:bg-silla"
			>
				<Icon name="chat" class="size-5" />
				¿Qué hay hoy?
			</a>
			{
				site.menuPdf ? (
					<a
						href={site.menuPdf}
						download
						class="rotulo flex w-fit items-center gap-2 border-b-2 border-tinta pb-1 text-[0.9rem] transition-colors hover:border-muro hover:text-muro"
					>
						<Icon name="carta" class="size-5" />
						Descargar la carta (PDF)
					</a>
				) : (
					<a
						href={whatsappLink('¡Hola! ¿Me pasan la carta?')}
						target="_blank"
						rel="noopener noreferrer"
						class="rotulo flex w-fit items-center gap-2 border-b-2 border-tinta pb-1 text-[0.9rem] transition-colors hover:border-muro hover:text-muro"
					>
						<Icon name="carta" class="size-5" />
						Pedinos la carta completa
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.pizarra {
		box-shadow:
			0 18px 30px -14px rgb(30 6 4 / 0.6),
			0 4px 8px -2px rgb(30 6 4 / 0.3);
	}
	.pizarra::after {
		content: '';
		position: absolute;
		inset: 10px;
		border: 1.5px solid rgb(43 26 20 / 0.25);
		pointer-events: none;
	}
</style>
