---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<!-- Se renderiza dentro del contenedor fijo de BottomNav: queda anclado sobre la barra y se mueven juntos -->
<a
	href={site.whatsappUrl}
	target="_blank"
	rel="noopener noreferrer"
	aria-label="Pedir por WhatsApp ahora"
	class="pointer-events-auto absolute right-4 bottom-full mb-6 flex items-center gap-2 rounded-full bg-whatsapp py-2.5 pr-4 pl-3 text-label-md text-primary shadow-[0_6px_20px_rgba(37,211,102,0.4)] transition-transform active:scale-95 md:right-8 md:mb-8"
>
	<Icon name="chat" class="text-[24px]" />
	<span class="font-bold tracking-tight">Pedir Helado</span>
</a>
