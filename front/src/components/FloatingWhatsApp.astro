---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="fixed right-4 bottom-20 z-40">
	<a
		href={site.whatsappUrl}
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Pedir por WhatsApp ahora"
		class="flex items-center gap-2 rounded-full bg-whatsapp py-2.5 pr-4 pl-3 text-label-md text-primary shadow-[0_6px_20px_rgba(37,211,102,0.4)] transition-all active:scale-95"
	>
		<Icon name="chat" class="text-[24px]" />
		<span class="font-bold tracking-tight">Pedir Helado</span>
	</a>
</div>
