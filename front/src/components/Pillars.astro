---
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';

const pillars = [
	{
		id: 'sabores',
		title: 'Helados de Autor',
		badge: { icon: 'icecream', label: 'Maestría Heladera' },
		image:
			'https://lh3.googleusercontent.com/aida-public/AB6AXuCvXxkXyJpxYjMiZ2WgvKkvNtUeF9xRUNMITvbq1wYwlfFFNP7oKwZK8HabVE2lit7VPun3qllJ8IYb_MTkub30Ld2nMKxPxhTSwKr1euSDOrMxZLR1Lge2VlzOeQuJZW-cM42HLHZwua4vfGUmj54z-telh9DI7tr7Q7WVfKpv6TE8ShuqZ_BvjN-JLKyAeiqBSqVODdgNasL9Duf-4bl9X_ng-1_S6Yto8mNj10-ypEWuW3lpw2hKtg',
		alt: 'Helado artesanal con pistachos y chocolate',
		description:
			'Elaboración diaria a la vista con leche fresca de granja, frutas naturales de estación y cacao puro. Cremosidad densa y sedosa al auténtico estilo gelato italiano.',
		tags: ['Pistacho Puro di Bronte', 'Dulce de Leche Almacén'],
		highlight: ['Opciones Veganas & Sin TACC'],
	},
	{
		id: 'cafe',
		title: 'Cafetería de Especialidad',
		badge: { icon: 'coffee', label: 'Granos Seleccionados' },
		image:
			'https://lh3.googleusercontent.com/aida-public/AB6AXuCmNg58fsqw5myFQjaAkTGzf3FqN0OAgDZgEUw9O3Tz2f6L7r4x9xzm85mihVJ9c7GqjTq-NA3yUkjPXUgr79S0W6SpVzoaJbuOwPthRlBj65yY2eD7Zqd1JevS8FxRKtlxPS-psOHZse4tu1E1LNV8rcZglCvmz9538XtACkOO-1qU7rZLksTz33rsCpH0XG1ong-w94s1PkVFoaZn-2wDzPcWxC3F27xvmwAZ7FeUSpIBEKqvODIgYg',
		alt: 'Barista sirviendo un flat white con latte art',
		description:
			'Tostados medios que resaltan notas florales, frutales y achocolatadas. Extracciones calibradas por baristas dedicados junto a pastelería recién horneada.',
		tags: ['Espresso Doble', 'Flat White', 'V60 & Cold Brew'],
		highlight: ['Croissants Artesanales'],
	},
];
---

<section class="flex flex-col gap-space-lg px-margin py-space-xl md:mx-auto md:w-full md:max-w-6xl md:px-8 md:gap-space-xl md:py-16">
	<SectionTitle eyebrow="Nuestras Pasiones" title="El equilibrio perfecto" centered />

	<div class="flex flex-col gap-space-md md:grid md:grid-cols-2 md:gap-space-lg">
		{
			pillars.map((pillar) => (
				<article id={pillar.id} class="flex flex-col overflow-hidden rounded-2xl bg-surface-container shadow-sm md:transition-shadow md:hover:shadow-md">
					<div class="relative h-48 w-full overflow-hidden md:h-64 lg:h-80">
						<img src={pillar.image} alt={pillar.alt} loading="lazy" class="h-full w-full object-cover" />
						<div class="absolute top-3 left-3 flex items-center gap-1 rounded-full bg-primary/80 px-space-sm py-1 text-label-sm text-on-primary backdrop-blur-sm">
							<Icon name={pillar.badge.icon} class="text-[14px]" />
							<span>{pillar.badge.label}</span>
						</div>
					</div>
					<div class="flex flex-1 flex-col p-space-md md:p-space-lg">
						<h3 class="font-headline text-headline-md text-primary md:text-headline-lg-mobile">{pillar.title}</h3>
						<p class="mt-1 mb-space-sm text-body-md text-on-surface-variant">{pillar.description}</p>
						<div class="mt-auto flex flex-wrap gap-1.5 pt-2">
							{pillar.tags.map((tag) => (
								<span class="rounded-lg bg-surface-container-high px-2.5 py-1 text-label-sm text-on-surface">{tag}</span>
							))}
							{pillar.highlight.map((tag) => (
								<span class="rounded-lg bg-secondary-fixed px-2.5 py-1 text-label-sm text-on-secondary-fixed">{tag}</span>
							))}
						</div>
					</div>
				</article>
			))
		}
	</div>
</section>
