---
import Icon from './Icon.astro';
import FloatingWhatsApp from './FloatingWhatsApp.astro';
import { site } from '../data/site';
---

<!-- Un solo contenedor fijo para la barra y el botón flotante, así no se desfasan al hacer scroll en mobile -->
<div class="pointer-events-none fixed inset-x-0 bottom-0 z-50">
	<FloatingWhatsApp />
	<nav
		aria-label="Principal"
		class="pb-safe pointer-events-auto bg-surface/90 shadow-[0_-4px_20px_rgba(43,27,23,0.08)] backdrop-blur-xl md:hidden"
	>
		<div class="flex items-center justify-around px-margin py-space-xs">
			{
				site.nav.map((link, i) => (
					<a
						href={link.href}
						aria-current={i === 0 ? 'page' : undefined}
						class:list={[
							'flex h-12 min-w-11 flex-col items-center justify-center transition-colors',
							i === 0 ? 'font-semibold text-secondary' : 'text-on-surface-variant hover:text-on-surface',
						]}
					>
						<Icon name={link.icon} class="text-[20px]" />
						<span class="mt-0.5 text-label-sm">{link.label}</span>
					</a>
				))
			}
		</div>
	</nav>
</div>
